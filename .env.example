# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable (client-safe) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role / secret key. Server-only -- deliberately NOT prefixed with
# NEXT_PUBLIC_, since anything prefixed is bundled into the browser build.
# Required for admin user management and the admin seeder.
SUPABASE_SECRET_KEY=

# Default administrator created by `bun run seed:admin`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
